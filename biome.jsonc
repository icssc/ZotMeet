{
	"$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": { "ignoreUnknown": true },
	"formatter": {
		"enabled": true,
		"includes": [
			"**",
			"!**/*.md",
			"!**/*.sql",
			"!**/*.ico",
			"!**/*.woff",
			"!**/db/migrations/**"
		]
	},
	"linter": {
		"enabled": true,
		"domains": {
			"next": "recommended"
		},
		"rules": {
			"recommended": true,
			"suspicious": {
				"noUnknownAtRules": {
					"level": "error",
					"options": {
						"ignore": ["tailwind"]
					}
				}
			},
			"nursery": {
				"useSortedClasses": {
					"level": "error",
					"fix": "safe",
					"options": {
						"attributes": ["className"],
						"functions": ["cn"]
					}
				}
			}
		},
		"includes": [
			"**",
			"!**/tailwind.config.ts",
			"!.next/**",
			"!out/**",
			"!build/**",
			"!next-env.d.ts",
			"!.next/**",
			"!out/**",
			"!build/**",
			"!next-env.d.ts",
			"!sst-env.d.ts",
			"!src/components/ui/**",
			"!sst.config.ts"
		]
	},
	// Import boundaries from AGENTS.md, enforced. Each override owns one area.
	"overrides": [
		{
			"includes": ["packages/shared/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"react",
											"react-*",
											"react-native",
											"react-native-*",
											"zustand",
											"next",
											"next/**",
											"server-only",
											"drizzle-orm",
											"drizzle-orm/**",
											"expo",
											"expo-*",
											"@mui/**",
											"@/**"
										],
										"message": "@zotmeet/shared is pure TS: date-fns, date-fns-tz and zod only. See packages/shared/AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["apps/mobile/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"react-native": {
										"importNames": ["Animated"],
										"message": "Use react-native-reanimated (via @/lib/animated when it takes a className)."
									},
									"@react-native-async-storage/async-storage": "Session state lives in expo-secure-store via useAuthStore."
								},
								"patterns": [
									{
										"group": [
											"@mui/**",
											"next",
											"next/**",
											"server-only",
											"drizzle-orm",
											"drizzle-orm/**"
										],
										"message": "Mobile has no MUI and no server code. Use components/ui/* and lib/api/*. See apps/mobile/AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"react-hook-form": "Forms use plain useState. See AGENTS.md → Ask first.",
									"swr": "Web data goes through server components and server actions. See AGENTS.md → Ask first.",
									"@tanstack/react-query": "Web data goes through server components and server actions. See AGENTS.md → Ask first."
								}
							}
						}
					}
				}
			}
		}
	],
	"html": {
		"formatter": {
			"selfCloseVoidElements": "always"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
