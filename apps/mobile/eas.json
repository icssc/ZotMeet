{
	"cli": {
		"version": ">= 23.2.0",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"channel": "development"
		},
		"preview": {
			"distribution": "internal",
			"channel": "preview"
		},
		"production": {
			"autoIncrement": true,
			"channel": "production",
			"env": {
				"EXPO_PUBLIC_API_URL": "https://zotmeet.com"
			}
		}
	},
	"submit": {
		"production": {}
	}
}
