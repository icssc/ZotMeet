# Base URL of the ZotMeet web app, which serves the /api/* routes the mobile
# app calls. On a physical device use your machine's LAN address instead of
# localhost, e.g. http://192.168.1.20:3000.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Optional dev-only bearer token, used only while signed out: must equal
# MOBILE_DEV_API_TOKEN on the web server (see the root .env.example). Signing
# in with Google replaces it with a real per-user session token. It is inlined
# into the JS bundle, so keep it in .env.local and never in eas.json or
# app.config.ts. It is a shared credential for one member, so the client reads
# it only under __DEV__ (`expo start`) and the server honours it only outside
# production: a build or `eas update` you hand to someone else has no
# credential until the user signs in, by design.
EXPO_PUBLIC_API_TOKEN=
