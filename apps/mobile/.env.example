# Base URL of the ZotMeet web app, which serves the /api/* routes the mobile
# app calls. On a physical device use your machine's LAN address instead of
# localhost, e.g. http://192.168.1.20:3000.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Dev-only bearer token: must equal MOBILE_DEV_API_TOKEN on the web server (see
# the root .env.example). It is inlined into the JS bundle, so keep it in
# .env.local and never in eas.json or app.config.ts.
EXPO_PUBLIC_API_TOKEN=
