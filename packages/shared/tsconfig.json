{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2022"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src"]
}
