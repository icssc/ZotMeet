DATABASE_URL=postgres://postgres:postgres@localhost:5432/zotmeet

# Public HTTPS origin for this deployment (emails, OAuth, Open Graph, sitemap).
# SST sets this automatically per stage; for local prod-like testing use:
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# iOS bundle ID from PWA Builder → Package for stores → iOS (update if yours differs).
NEXT_PUBLIC_IOS_BUNDLE_ID=com.zotmeet.app

# IARC certification code from https://www.globalratings.com/ (via a participating
# storefront questionnaire). Clears the PWABuilder IARC action item when set.
# PWA_IARC_RATING_ID=

# Register the service worker in non-production builds (e.g. when testing with PWABuilder
# against a preview URL). Leave unset in local dev unless you need SW debugging.
# NEXT_PUBLIC_ENABLE_SW=true

# EAS project id of apps/mobile (the same value the mobile workflows use). Lets
# Expo Go running a published EAS Update of that project — a PR preview — use
# native sign-in against this server. Local development does not need it.
# EAS_PROJECT_ID=

# Mobile guest account (see src/lib/auth/bearer.ts). The Expo app sends
# MOBILE_DEV_API_TOKEN as a bearer token and is signed in as
# MOBILE_DEV_HOST_MEMBER_ID — "Seed Admin" from `pnpm db:seed`, who hosts a
# few seeded meetings — so a phone can use the app without Google sign-in.
# Local development only: the server ignores them when NODE_ENV=production, so
# they cannot enable host impersonation on a deployed instance. The default
# token is fine locally (it only ever reaches your own server); it must match
# EXPO_PUBLIC_API_TOKEN in apps/mobile/.env.local.
MOBILE_DEV_API_TOKEN=zotmeet-local-dev
MOBILE_DEV_HOST_MEMBER_ID=00000000-0000-0000-0000-000000000000
